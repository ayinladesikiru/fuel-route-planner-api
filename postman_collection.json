{
  "info": {
    "name": "Fuel Route Planner API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Route + cost-optimal fuel stops between two US locations. Open `map_url` from any response in a browser to see the map."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "if (b.summary) {",
              "  pm.test('at most 1 routing API call', () => pm.expect(b.meta.routing_api_calls).to.be.at.most(1));",
              "  if (b.meta.route_from_cache) {",
              "    pm.test('cached trip answered in < 300 ms', () => pm.expect(pm.response.responseTime).to.be.below(300));",
              "  }",
              "  pm.test('total equals sum of stops', () => {",
              "    const sum = b.fuel_stops.reduce((t, s) => t + s.cost, 0);",
              "    pm.expect(Math.abs(sum - b.summary.total_fuel_cost)).to.be.below(0.05);",
              "  });",
              "  console.log(`Total fuel cost: $${b.summary.total_fuel_cost} over ${b.summary.number_of_stops} stops`);",
              "  console.log('Map:', b.map_url);",
              "}"
            ]
          }
        }
      ]
    },
